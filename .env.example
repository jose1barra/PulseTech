# Copy to .env on the application server; keep actual credentials out of Git.
APP_ORIGIN=https://field.example.com
SETUP_TOKEN=replace-with-a-long-random-setup-code
DATABASE_URL=postgresql://pulsetech:CHANGE_ME@db.internal:5432/pulsetech?sslmode=verify-full
# Use the app server's private IP only when the reverse proxy is another host.
BIND_IP=127.0.0.1
